diff --git a/vllm/model_executor/model_loader/utils.py b/vllm/model_executor/model_loader/utils.py
index d80b7d1..e3761e0 100644
--- a/vllm/model_executor/model_loader/utils.py
+++ b/vllm/model_executor/model_loader/utils.py
@@ -153,6 +153,21 @@ def process_weights_after_loading(
             with device_loading_context(module, target_device):
                 module.process_weights_after_loading(model_config.dtype)
 
+    if model_config.quantization == "exl3":
+        from vllm_exl3.expert_cache_loader import cache_rows, install_expert_cache
+
+        if cache_rows() and model_config.hf_config.model_type != "qwen4_exp_mtp":
+            config = get_current_vllm_config()
+            scheduler = config.scheduler_config
+            decode_tokens = scheduler.max_num_seqs if scheduler is not None else 1
+            if config.speculative_config is not None:
+                decode_tokens *= 1 + config.speculative_config.num_speculative_tokens
+            install_expert_cache(
+                model,
+                target_device,
+                decode_tokens,
+            )
+
     # Model-level post-load hook, after the per-layer quant finalize.
     if hasattr(model, "process_weights_after_loading"):
         model.process_weights_after_loading()
